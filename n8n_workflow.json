    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse the JSON array from the previous node\nconst imagePrompts = $input.item.json.imagePrompts;\n\n// If imagePrompts is a string, parse it as JSON\nconst promptsArray = typeof imagePrompts === 'string' ? JSON.parse(imagePrompts) : imagePrompts;\n\n// Ensure we have an array\nif (!Array.isArray(promptsArray)) {\n  throw new Error('imagePrompts is not an array');\n}\n\n// Return each item with all metadata (prompt, caption, altText, placement)\nreturn promptsArray.map(item => ({\n  json: {\n    prompt: item.prompt || item.imagePrompt || '',\n    caption: item.caption || '',\n    altText: item.altText || item.alt || '',\n    placement: item.placement || item.position || 'full-width',\n    description: item.description || '',\n    previewStyle: item.previewStyle || item.style || 'full-width'\n  }\n}));"
      },

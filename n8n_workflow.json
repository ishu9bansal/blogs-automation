    {
      "parameters": {
        "jsCode": "// Assemble Article - Combine metadata and images into final Medium-ready format\n\n/**\n * EXPECTED INPUT STRUCTURE FROM MERGE NODE:\n * \n * Input 1 (Metadata Branch):\n * {\n *   \"title\": \"Article Title\",\n *   \"subtitle\": \"Article Subtitle\",\n *   \"tags\": [\"tag1\", \"tag2\", \"tag3\"],\n *   \"canonicalUrl\": \"https://example.com/original\",\n *   \"publishStatus\": \"draft\" | \"public\",\n *   \"linkedInPost\": \"LinkedIn engagement post text\",\n *   \"content\": \"Full article body with markdown formatting...\",\n *   \"body\": \"Alternative field for article content\"\n * }\n * \n * Input 2 (Image Branch):\n * {\n *   \"images\": [\n *     {\n *       \"url\": \"https://image-url.com/image1.png\",\n *       \"imageUrl\": \"Alternative field for image URL\",\n *       \"caption\": \"Image caption text\",\n *       \"description\": \"Alternative field for caption\",\n *       \"previewStyle\": \"hero\" | \"full-width\" | \"inset\" | \"side-by-side\"\n *     },\n *     { ... more images ... }\n *   ]\n * }\n * \n * EXAMPLE OUTPUT FORMAT:\n * {\n *   \"title\": \"Article Title\",\n *   \"contentFormat\": \"html\",\n *   \"content\": \"<h1>Title</h1>\\n<h2>Subtitle</h2>\\n<p>Paragraph...</p>\\n<figure class='full-width-image'>\\n  <img src='...' alt='...' />\\n  <figcaption>Caption</figcaption>\\n</figure>\\n...\",\n *   \"tags\": [\"tag1\", \"tag2\", \"tag3\"],\n *   \"canonicalUrl\": \"https://example.com/original\",\n *   \"publishStatus\": \"draft\",\n *   \"metadata\": {\n *     \"subtitle\": \"Article Subtitle\",\n *     \"linkedInPost\": \"LinkedIn post text\",\n *     \"imageCount\": 3,\n *     \"wordCount\": 1250\n *   }\n * }\n */\n\nconst metadataInput = $input.first();\nconst imagesInput = $input.last();\n\n// Extract metadata from first input\nconst metadata = metadataInput.json;\nconst title = metadata.title || 'Untitled Article';\nconst subtitle = metadata.subtitle || '';\nconst tags = metadata.tags || [];\nconst canonicalUrl = metadata.canonicalUrl || '';\nconst publishStatus = metadata.publishStatus || 'draft';\nconst linkedInPost = metadata.linkedInPost || '';\n\n// Extract images from second input\nconst images = imagesInput.json.images || [];\n\n// Build the article content in Medium HTML format\nlet content = '';\n\n// Add title and subtitle\nif (title) {\n  content += `<h1>${title}</h1>\\n`;\n}\nif (subtitle) {\n  content += `<h2>${subtitle}</h2>\\n`;\n}\n\n// Get the article body from metadata\nconst articleBody = metadata.content || metadata.body || '';\n\n// Split article into sections (by paragraphs or headings)\nconst sections = articleBody.split(/\\n\\n+/);\n\n// Calculate image placement based on preview styles\nconst totalSections = sections.length;\nconst totalImages = images.length;\n\n// Distribute images throughout the article\nlet imageIndex = 0;\nconst imageInterval = Math.floor(totalSections / (totalImages + 1));\n\nfor (let i = 0; i < sections.length; i++) {\n  const section = sections[i].trim();\n  \n  if (section) {\n    // Check if section is a heading\n    if (section.startsWith('#')) {\n      const headingLevel = section.match(/^#+/)[0].length;\n      const headingText = section.replace(/^#+\\s*/, '');\n      content += `<h${headingLevel}>${headingText}</h${headingLevel}>\\n`;\n    } else {\n      content += `<p>${section}</p>\\n`;\n    }\n  }\n  \n  // Insert image at calculated intervals\n  if (imageIndex < totalImages && (i + 1) % imageInterval === 0 && i < totalSections - 1) {\n    const image = images[imageIndex];\n    const imageUrl = image.url || image.imageUrl || '';\n    const imageCaption = image.caption || image.description || '';\n    const previewStyle = image.previewStyle || 'full-width';\n    \n    if (imageUrl) {\n      // Apply preview style as figure class or inline style\n      let figureClass = '';\n      switch (previewStyle) {\n        case 'hero':\n          figureClass = 'hero-image';\n          break;\n        case 'full-width':\n          figureClass = 'full-width-image';\n          break;\n        case 'inset':\n          figureClass = 'inset-image';\n          break;\n        case 'side-by-side':\n          figureClass = 'side-by-side-image';\n          break;\n        default:\n          figureClass = 'full-width-image';\n      }\n      \n      content += `<figure class=\"${figureClass}\">\\n`;\n      content += `  <img src=\"${imageUrl}\" alt=\"${imageCaption}\" />\\n`;\n      if (imageCaption) {\n        content += `  <figcaption>${imageCaption}</figcaption>\\n`;\n      }\n      content += `</figure>\\n`;\n    }\n    \n    imageIndex++;\n  }\n}\n\n// Add any remaining images at the end\nwhile (imageIndex < totalImages) {\n  const image = images[imageIndex];\n  const imageUrl = image.url || image.imageUrl || '';\n  const imageCaption = image.caption || image.description || '';\n  const previewStyle = image.previewStyle || 'full-width';\n  \n  if (imageUrl) {\n    let figureClass = previewStyle === 'hero' ? 'hero-image' : 'full-width-image';\n    content += `<figure class=\"${figureClass}\">\\n`;\n    content += `  <img src=\"${imageUrl}\" alt=\"${imageCaption}\" />\\n`;\n    if (imageCaption) {\n      content += `  <figcaption>${imageCaption}</figcaption>\\n`;\n    }\n    content += `</figure>\\n`;\n  }\n  \n  imageIndex++;\n}\n\n// Prepare final article object for Medium API\nconst assembledArticle = {\n  title: title,\n  contentFormat: 'html',\n  content: content,\n  tags: tags,\n  canonicalUrl: canonicalUrl,\n  publishStatus: publishStatus,\n  metadata: {\n    subtitle: subtitle,\n    linkedInPost: linkedInPost,\n    imageCount: totalImages,\n    wordCount: articleBody.split(/\\s+/).length\n  }\n};\n\nreturn [{ json: assembledArticle }];"
      },
